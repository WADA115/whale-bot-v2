{
    "version":  "0.1.0",
    "name":  "xiaoyu-desktop",
    "main":  "main.js",
    "description":  "小鲸鱼面板桌面壳",
    "scripts":  {
                    "start":  "node launch.js",
                    "dev":  "node launch.js"
                },
    "devDependencies":  {
                            "electron":  "^45.2.3",
                            "electron-builder":  "^26.18.0"
                        },
    "private":  true,
    "build":  {
                  "appId":  "com.xiaoyu.panel",
                  "productName":  "小鲸鱼",
                  "directories":  {
                                      "output":  "dist"
                                  },
                  "asar":  true,
                  "files":  [
                                "main.js",
                                "package.json"
                            ],
                  "win":  {
                              "target":  [
                                             {
                                                 "target":  "portable",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ],
                              "artifactName":  "小鲸鱼-${version}.exe",
                              "icon":  "assets/icon.ico"
                          },
                  "portable":  {
                                   "artifactName":  "小鲸鱼-${version}.exe"
                               },
                  "extraResources":  [
                                         {
                                             "from":  "assets/icon.png",
                                             "to":  "icon.png"
                                         }
                                     ]
              }
}
